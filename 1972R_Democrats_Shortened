e.candidateSwitcher = () => {
    let potential_candidate_pks = e.candidate_switch_json
        .filter(f => f.fields.from_candidate == e.candidate_id)
        .map(f => f.fields.to_candidate);

    let pot_cand = potential_candidate_pks
        .map(f => e.candidate_json.find(_f => _f.pk === f));

    let candidate_options = ``;

    pot_cand.forEach(f => {
        candidate_options += `<option value="${f.pk}">${f.fields.first_name} ${f.fields.last_name}</option>\n`;
    });

    let candidate_html = `
        <div id="candidate_form">
            <form name="candidate switch">
                <p></p>
                <h3>Please select your presidential candidate:</h3> 
                <select name="candidate_id" id="candidate_id">
                    ${candidate_options}
                </select>
                <p></p>
            </form>
        </div>

        <div class="person_description_window" id="candidate_description_window">
            <div class="person_image" id="candidate_image"> 
                <img src="${pot_cand[0].fields.image_url}" width="210" height="250"> 
            </div>
            <div class="person_summary" id="candidate_summary">
                <ul>
                    <li>Name: ${pot_cand[0].fields.first_name} ${pot_cand[0].fields.last_name}</li>
                    <li>Party: ${pot_cand[0].fields.party}</li>
                    <li>Home State: ${pot_cand[0].fields.state}</li>
                </ul>
                ${pot_cand[0].fields.description}
            </div>
        </div>

        <p> <button class="person_button" id="candidate_id_button">Continue</button> </p>
    `;

    let candidate_screen = document.createElement("div");
    candidate_screen.classList.add("inner_window_w_desc");
    candidate_screen.id = "inner_window_candidate";
    candidate_screen.innerHTML = candidate_html;

    changeGameDisp(true);

    gameWindow.appendChild(candidate_screen);

    // update preview on change
    $("#candidate_id").change((_e) => {
        _e.preventDefault();

        let value = Number($("#candidate_id").val());
        let i = potential_candidate_pks.findIndex(f => f === value);

        let screen_html = `
            <div class="person_image" id="candidate_image"> 
                <img src="${pot_cand[i].fields.image_url}" width="210" height="250"> 
            </div>
            <div class="person_summary" id="candidate_summary">
                <ul>
                    <li>Name: ${pot_cand[i].fields.first_name} ${pot_cand[i].fields.last_name}</li>
                    <li>Party: ${pot_cand[i].fields.party}</li>
                    <li>Home State: ${pot_cand[i].fields.state}</li>
                </ul>
                ${pot_cand[i].fields.description}
            </div>
        `;

        $("#candidate_description_window").html(screen_html);
    });

    // confirm selection
    $("#candidate_id_button").click((_e) => {
        _e.preventDefault();

        let value = Number($("#candidate_id").val());
        let i = potential_candidate_pks.findIndex(f => f === value);

        e.candidate_id = pot_cand[i].pk;
        e.candidate_last_name = pot_cand[i].fields.last_name;
        e.candidate_image_url = pot_cand[i].fields.image_url;
        e.selected_candidate = pot_cand[i];

        if ($("#campaign_sign")[0]) {
            $("#campaign_sign").html(`<p>${e.candidate_last_name}</p><p>${e.running_mate_last_name || ""}</p>`);
            $("#candidate_pic").attr("src", e.candidate_image_url);
        }

        $("#inner_window_candidate").remove();
        changeGameDisp(false);
    });
}  
