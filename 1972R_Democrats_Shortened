let establishment = window.campaignVars.establishment;
let minorities = window.campaignVars.minorities;
let south = window.campaignVars.south;
let partyUnity = window.campaignVars.partyUnity;

let unityStatus = "";
let leftStatus = "";
let laborStatus = "";
let establishmentStatus = "";
let minoritiesStatus = "";
let southStatus = "";

/*
FOR TESTING:

const v = window.campaignVars;

// Party Unity
unityStatus = "Party Unity: " + v.partyUnity;

// Left
leftStatus = "Left: " + v.left;

// Labor
laborStatus = "Labor: " + v.labor;

