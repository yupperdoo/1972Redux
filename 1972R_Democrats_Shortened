establishmentStatus = "Establishment: " + v.establishment;

// Minorities
minoritiesStatus = "Minorities: " + v.minorities;

// South
southStatus = "South: " + v.south;
*/

// Party Unity
if (partyUnity >= 10) unityStatus = "The party is holding together.";
else if (partyUnity >= 5) unityStatus = "The party is uneasy but intact.";
else if (partyUnity >= 0) unityStatus = "The party is drifting into factions.";
else if (partyUnity >= -5) unityStatus = "The party is breaking apart.";
else unityStatus = "The party is in open turmoil.";

// Left
if (left >= 10) leftStatus = "The insurgents are ascendant.";
else if (left >= 5) leftStatus = "The insurgents are gaining ground.";
else if (left >= 0) leftStatus = "The insurgents are holding their own.";
else if (left >= -5) leftStatus = "The insurgents are losing momentum.";
else leftStatus = "The insurgents are fading out.";

// Labor
if (labor >= 10) laborStatus = "Organized labor is firmly in control.";
else if (labor >= 5) laborStatus = "Organized labor retains the upper hand.";
else if (labor >= 0) laborStatus = "Organized labor is holding steady.";
else if (labor >= -5) laborStatus = "Organized labor is losing leverage.";
else laborStatus = "Organized labor is being sidelined.";

// Establishment
if (establishment >= 10) establishmentStatus = "The establishment is firmly in control.";
else if (establishment >= 5) establishmentStatus = "The establishment retains the upper hand.";
else if (establishment >= 0) establishmentStatus = "The establishment is holding steady.";
else if (establishment >= -5) establishmentStatus = "The establishment is losing leverage.";
else establishmentStatus = "The establishment is being sidelined.";

// Minorities
if (minorities >= 10) minoritiesStatus = "Minority leaders are driving the conversation.";
else if (minorities >= 5) minoritiesStatus = "Minority voices are gaining strength.";
else if (minorities >= 0) minoritiesStatus = "Minority leaders are making inroads.";
else if (minorities >= -5) minoritiesStatus = "Minority leaders are being overlooked.";
else minoritiesStatus = "Minority leaders are being shut out.";

// South
if (south >= 10) southStatus = "Southern Democrats are driving the conversation.";
else if (south >= 5) southStatus = "Southern Democrats retain the upper hand.";
else if (south >= 0) southStatus = "Southern Democrats are holding steady.";
else if (south >= -5) southStatus = "Southern Democrats are losing influence.";
else southStatus = "Southern Democrats are drifting away.";

return {
    leftStatus,
    laborStatus,
    establishmentStatus,
    minoritiesStatus,
    southStatus,
    unityStatus
};

}

