const margin = 3;

function close(a, b) {
    return Math.abs(a - b) <= margin;
}

function closeGroup(group) {
    return Math.max(...group) - Math.min(...group) <= margin;
}

function dominates(group, others) {
    return Math.min(...group) - Math.max(...others) >= margin;
}
function gap(a, b) {
    return Math.abs(a - b);
