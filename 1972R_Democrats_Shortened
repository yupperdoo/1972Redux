function showCandidateScreen(config) {

    campaignTrail_temp.input_locked = true;

    const candidate_html = `
<div style="background-color: rgb(245, 222, 188); padding: 20px; border-radius: 6px; line-height: 1.5; font-size: 1.05em;">

<!-- DROPDOWN (TOP) -->
<div style="margin-bottom: 10px;">
<select id="candidate_dropdown">
    <option value="${config.name}">${config.name}</option>
</select>
</div>

<!-- CANDIDATE BOX -->
<div class="person_description_window">

<div class="person_image">
<img src="${config.img}" width="200" height="250">
</div>

<div class="person_summary">
<ul>
<li>Name: ${config.name}</li>
<li>State: ${config.subtitle1}</li>
<li>Position: ${config.subtitle2}</li>
</ul>

<p>${config.bio}</p>

</div>

</div>

<div style="margin-top: 10px;">
<button id="confirm_screen">Continue</button>
</div>

</div>
`;

    let screen = document.createElement("div");
    screen.classList.add("inner_window_w_desc");
    screen.id = "candidate_screen";
    screen.innerHTML = candidate_html;

    changeGameDisp(true);
    gameWindow.appendChild(screen);

    // ===============================
    // CLEANUP FUNCTION (shared safety)
    // ===============================
    const cleanup = () => {
        campaignTrail_temp.input_locked = false;
        $("#candidate_screen").remove();
        changeGameDisp(false);
        document.removeEventListener("keydown", keyHandler, true);
    };

    // ===============================
    // KEY HANDLER (STEP 2)
    // ===============================
    const keyHandler = (e) => {
        if (!campaignTrail_temp.input_locked) return;

        if (e.key === "ArrowRight") {
            e.preventDefault();
            e.stopPropagation();

            cleanup();

            setTimeout(() => {
                $("#next").trigger("click");
            }, 0);
        }

        if (e.key === "ArrowLeft") {
            e.preventDefault();
            e.stopPropagation();

            cleanup();

            setTimeout(() => {
                $("#back").trigger("click");
            }, 0);
        }

        if (e.key === "Escape") {
            e.preventDefault();
            e.stopPropagation();

            cleanup();

            setTimeout(() => {
                $("#back").trigger("click");
            }, 0);
        }
    };

    document.addEventListener("keydown", keyHandler, true);

    // ===============================
    // CONFIRM BUTTON (STEP 3)
    // ===============================
    $("#confirm_screen").click(() => {

        const selected = document.getElementById("candidate_dropdown")?.value;
        console.log("Selected candidate:", selected);

        cleanup();

        setTimeout(() => {
            $("#next").trigger("click");
        }, 0);
    });
}
